# Public production origin used for canonical URLs, sitemap, robots, and form origin checks.
# www is the primary host. The apex (https://23labs.co) redirects to www.
# Set this in Vercel Production as well. An apex value is rewritten to www in code,
# but the Vercel variable should still match the canonical host.
NEXT_PUBLIC_SITE_URL=https://www.23labs.co

# GA4 measurement ID. Optional override. When unset, the site uses G-WW10V0N5G6.
# Set this in Vercel Production as well so the property ID is explicit there.
NEXT_PUBLIC_GA_ID=G-WW10V0N5G6

# Resend contact form delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@23labs.co
CONTACT_FROM_EMAIL=23Labs <hello@23labs.co>
